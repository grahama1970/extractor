{
  "name": "gold-annotator-web",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3002",
    "dev:poll": "WATCHPACK_POLLING=true CHOKIDAR_USEPOLLING=1 next dev -H 0.0.0.0 -p 3002",
    "dev:daemon": "node scripts/dev_daemon.js start",
    "dev:daemon:stop": "node scripts/dev_daemon.js stop",
    "dev:daemon:status": "node scripts/dev_daemon.js status",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3002",
    "lint": "eslint .",
    "interactions": "node tests/interactions/run.js",
    "interactions:render": "node tests/interactions/run.js --pattern render,doc_select",
    "interactions:boxes": "node tests/interactions/run.js --pattern boxes_and_hud,save_boxes",
    "interactions:export": "node tests/interactions/run.js --pattern export_annotated",
    "watch:interactions": "chokidar 'app/**/*' 'components/**/*' -c 'node tests/interactions/run.js --pattern render,doc_select'",
    "dev:reset": "node scripts/dev_daemon.js stop; rm -rf .next; node scripts/dev_daemon.js start; node -e 'console.log(`Dev restarted on port: `+require(\"fs\").readFileSync(\".next-dev.port\",\"utf8\").trim())'",
    "debug:proto": "node scripts/debug_proto.js --url=http://localhost:3002/proto_canvas.html",
    "debug:proto:remote": "node scripts/debug_proto_browserless.js --endpoint=${BROWSERLESS_WS:-ws://127.0.0.1:3000?token=changeme} --url=${TARGET_URL:-http://localhost:3002/proto_canvas.html}",
    "debug:proto:cdp": "node scripts/debug_proto_cdp.js"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.0",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@tldraw/tldraw": "^3.15.4",
    "autoprefixer": "^10.4.16",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "konva": "^9.3.15",
    "lucide-react": "^0.452.0",
    "next": "^14.2.5",
    "pdfjs-dist": "^4.5.136",
    "postcss": "^8.4.31",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.51.4",
    "react-konva": "^18.2.10",
    "tailwind-merge": "^2.2.1",
    "tailwindcss": "^3.4.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.21",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.2.5",
    "puppeteer": "^22.0.0",
    "typescript": "^5.4.3"
  }
}