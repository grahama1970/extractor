# LiteLLM Environment Variables Example
# Copy this file to .env and fill in your API keys

# OpenAI API Key (required for OpenAI models)
OPENAI_API_KEY=your_openai_api_key_here

# Google API Key (required for Google/Vertex models)
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic API Key (required for Claude models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Other provider API keys can be added as needed
# See https://docs.litellm.ai/docs/providers for all supported providers

# Redis Cache Configuration (optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=86400  # 24 hour cache TTL in seconds