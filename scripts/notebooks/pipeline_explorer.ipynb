    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "# Extractor Pipeline Explorer (Read‑Only)\n",
        "\n",
        "Purpose: a lightweight, no‑logic notebook to inspect artifacts from stages 04→09.\n",
        "- Reads JSON artifacts, prints concise metrics, and shows short slices.\n",
        "- Does not mutate data or call LLMs.\n",
        "- Safe to share; secrets are masked in displays.\n",
        "\n",
        "Tips:\n",
        "- Update `RUN_ROOT` if you want to point at an alternate results directory.\n",
        "- Cells are independent; running top → bottom is recommended.\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Verification Checklist (Read‑Only)\n",
        "\n",
        "Run this cell to verify key artifacts and invariants were produced as expected.\n",
        "Outputs a PASS/FAIL list and writes a JSON summary to `scripts/artifacts/pipeline_verification.json`."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "from pathlib import Path as _P\n",
        "import json, re, os\n",
        "\n",
        "def _pass(msg): print('✅ PASS -', msg)\n",
        "def _fail(msg): print('❌ FAIL -', msg)\n",
        "summary = {\n",
        "  'env': {}, 'stages': {}, 'warnings': []\n",
        "}\n",
        "# Env sanity (masked)\n",
        "base = os.environ.get('CHUTES_API_BASE','')\n",
        "key  = os.environ.get('CHUTES_API_KEY','')\n",
        "text_model = os.environ.get('CHUTES_TEXT_MODEL')\n",
        "vlm_model  = os.environ.get('CHUTES_VLM_MODEL') or os.environ.get('LITELLM_LARGE_VLLM_MODEL')\n",
        "ok_base = base.endswith('/v1')\n",
        "ok_key  = len(key) > 10\n",
        "summary['env'] = {'CHUTES_API_BASE_ok': ok_base, 'CHUTES_API_KEY_present': ok_key, 'CHUTES_TEXT_MODEL': bool(text_model), 'VLM_model_set': bool(vlm_model)}\n",
        "_pass('CHUTES_API_BASE ends with /v1') if ok_base else _fail('CHUTES_API_BASE should end with /v1')\n",
        "_pass('CHUTES_API_KEY present') if ok_key else _fail('CHUTES_API_KEY missing')\n",
        "# 06a enriched present\n",
        "et = _read_json(ART['enriched_tables']); ef = _read_json(ART['enriched_figures'])\n",
        "ok_06a = isinstance(et, list) and len(et) > 0 and isinstance(ef, list) and len(ef) > 0\n",
        "summary['stages']['06a_enriched'] = ok_06a\n",
        "_pass('06a enriched tables & figures present') if ok_06a else _fail('06a enriched outputs missing/empty')\n",
        "# 07 reflow consumption + status\n",
        "rf = _read_json(ART['reflowed']) or {}\n",
        "ok_07_status = rf.get('status') == 'Completed' and (rf.get('section_count') or 0) > 0\n",
        "src_files = rf.get('source_files') or {}\n",
        "ok_07_consumed = isinstance(src_files.get('tables'), str) and src_files.get('tables','').endswith('05_tables.enriched.json')\n",
        "summary['stages']['07_reflow'] = {'completed': ok_07_status, 'consumed_enriched': ok_07_consumed}\n",
        "_pass('07 reflow Completed with sections>0') if ok_07_status else _fail('07 reflow not completed or no sections')\n",
        "_pass('07 consumed 06a enriched tables') if ok_07_consumed else _fail('07 did not reference enriched tables')\n",
        "# 07½ requirements miner: count>0, strict modality only\n",
        "rq = _read_json(ART['reqs']) or {}\n",
        "reqs = rq.get('requirements', rq if isinstance(rq, list) else [])\n",
        "ok_reqs_count = len(reqs) > 0\n",
        "weak = [r for r in reqs if str(r.get('modality','')).lower() in {'should','may','might','could','can'}]\n",
        "ok_reqs_strict = len(weak) == 0\n",
        "path_missing = [r for r in reqs[:50] if not ((r.get('source') or {}).get('section_path'))]\n",
        "ok_reqs_section_path = len(path_missing) == 0\n",
        "summary['stages']['07_requirements'] = {'count': len(reqs), 'strict_modal': ok_reqs_strict, 'has_section_path': ok_reqs_section_path}\n",
        "_pass(f'07½ requirements count={len(reqs)}') if ok_reqs_count else _fail('No requirements found')\n",
        "_pass('Requirements use strict modality only') if ok_reqs_strict else _fail(f'Found weak modalities in {len(weak)} items')\n",
        "_pass('Requirements include section_path (sample OK)') if ok_reqs_section_path else _fail('Some requirements missing section_path (sample)')\n",
        "# 08 proofs summary\n",
        "th = _read_json(ART['theorems']) or {}\n",
        "stats = th.get('statistics') or {}\n",
        "ok_08_present = bool(stats)\n",
        "proved = stats.get('successful_proofs')\n",
        "total  = stats.get('total_requirements_found')\n",
        "ok_08_numbers = isinstance(proved,int) and isinstance(total,int) and total >= 0 and proved >= 0\n",
        "summary['stages']['08_proofs'] = {'present': ok_08_present, 'successful_proofs': proved, 'total': total}\n",
        "_pass(f'08 proofs present: proved={proved}/{total}') if (ok_08_present and ok_08_numbers) else _fail('08 proofs summary missing or invalid')\n",
        "# Optional threshold check (warn only)\n",
        "try:\n",
        "    ratio = (proved or 0) / (total or 1)\n",
        "    if ratio < 0.7:\n",
        "        summary['warnings'].append(f'low_proof_ratio:{ratio:.2f}')\n",
        "        _fail(f'Proof ratio low: {ratio:.2f}')\n",
        "    else:\n",
        "        _pass(f'Proof ratio OK: {ratio:.2f}')\n",
        "except Exception:\n",
        "    pass\n",
        "# Bridge health (if captured)\n",
        "health_p = _P('scripts/artifacts/certainly_healthz.json')\n",
        "if health_p.exists():\n",
        "    try:\n",
        "        h = json.loads(health_p.read_text())\n",
        "        ok = bool(h.get('ok'))\n",
        "        summary['stages']['08_bridge_healthz'] = ok\n",
        "        _pass('Certainly bridge healthz ok') if ok else _fail('Bridge healthz not ok')\n",
        "    except Exception as e:\n",
        "        _fail(f'Bridge healthz unreadable: {e}')\n",
        "# Logs quick scan\n",
        "bad = []\n",
        "for p in sorted(_P('scripts/artifacts').glob('*.log')):\n",
        "    try:\n",
        "        t = p.read_text()\n",
        "        if re.search(r'(ERROR|Traceback)', t): bad.append(p.name)\n",
        "    except Exception: pass\n",
        "summary['warnings'].extend([f'errors_in:{n}' for n in bad])\n",
        "_pass('No ERROR/Traceback in artifact logs') if not bad else _fail(f'Errors detected in logs: {bad[:4]}')\n",
        "# Save summary\n",
        "_P('scripts/artifacts').mkdir(parents=True, exist_ok=True)\n",
        "(_P('scripts/artifacts') / 'pipeline_verification.json').write_text(json.dumps(summary, indent=2))\n",
        "summary\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Optional Charts (no dependencies beyond matplotlib if available)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "try:\n",
        "    import matplotlib.pyplot as plt\n",
        "    rq = _read_json(ART['reqs']) or {}\n",
        "    reqs = rq.get('requirements', rq if isinstance(rq, list) else [])\n",
        "    from collections import Counter\n",
        "    src = Counter([r.get('from','?') for r in reqs])\n",
        "    mod = Counter([r.get('modality','?') for r in reqs])\n",
        "    fig, ax = plt.subplots(1,2, figsize=(8,3))\n",
        "    ax[0].bar(list(src.keys()), list(src.values())); ax[0].set_title('Requirements by Source')\n",
        "    ax[1].bar(list(mod.keys()), list(mod.values())); ax[1].set_title('Requirements by Modality')\n",
        "    plt.tight_layout(); plt.show()\n",
        "except Exception as e:\n",
        "    print('Charts skipped:', e)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {"collapsed": false},
      "outputs": [],
      "source": [
        "# Configuration\n",
        "from pathlib import Path\n",
        "import json, os, re, glob, textwrap, subprocess\n",
        "\n",
        "RUN_ROOT = Path('data/results/pipeline')  # change if using an iter run\n",
        "ART = {\n",
        "  'sections': RUN_ROOT / '04_section_builder/json_output/04_sections.json',\n",
        "  'tables':   RUN_ROOT / '05_table_extractor/json_output/05_tables.json',\n",
        "  'figures':  RUN_ROOT / '06_figure_extractor/json_output/06_figures.json',\n",
        "  'enriched_tables': RUN_ROOT / '06a_title_caption_enricher/json_output/05_tables.enriched.json',\n",
        "  'enriched_figures': RUN_ROOT / '06a_title_caption_enricher/json_output/06_figures.enriched.json',\n",
        "  'layout_sketch': RUN_ROOT / '06b_layout_sketcher/json_output/06b_layout_sketch.json',\n",
        "  'reflowed': RUN_ROOT / '07_reflow_section/json_output/07_reflowed.json',\n",
        "  'reqs': RUN_ROOT / '07_requirements_miner/json_output/07_requirements.json',\n",
        "  'theorems': RUN_ROOT / '08_lean4_theorem_prover/json_output/08_theorems.json',\n",
        "  'rate_limit_report': Path('scripts/artifacts/rate_limit_report.txt'),\n",
        "}\n",
        "\n",
        "def _read_json(p: Path):\n",
        "    try:\n",
        "        return json.loads(p.read_text()) if p.exists() else None\n",
        "    except Exception as e:\n",
        "        print(f'Failed to read {p}:', e)\n",
        "        return None\n",
        "\n",
        "def _mask(s: str, keep=6):\n",
        "    if not s: return s\n",
        "    return s[:keep] + '…' if len(s) > keep else '…'\n",
        "\n",
        "# Print environment (masked)\n",
        "env_slice = {\n",
        "    'CHUTES_API_BASE': os.environ.get('CHUTES_API_BASE'),\n",
        "    'CHUTES_TEXT_MODEL': os.environ.get('CHUTES_TEXT_MODEL'),\n",
        "    'CHUTES_VLM_MODEL': os.environ.get('CHUTES_VLM_MODEL') or os.environ.get('LITELLM_LARGE_VLLM_MODEL'),\n",
        "    'CERTAINLY_BRIDGE_BASE': os.environ.get('CERTAINLY_BRIDGE_BASE'),\n",
        "}\n",
        "if os.environ.get('OPENROUTER_API_KEY'):\n",
        "    env_slice['OPENROUTER_API_KEY'] = _mask(os.environ['OPENROUTER_API_KEY'])\n",
        "env_slice\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Stage 04 — Sections (04_sections.json)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "sec = _read_json(ART['sections'])\n",
        "if not sec:\n",
        "    print('Missing:', ART['sections'])\n",
        "else:\n",
        "    rs = sec.get('sections') or sec.get('reflowed_sections') or []\n",
        "    print('sections_count =', len(rs))\n",
        "    if rs:\n",
        "        first = rs[0]\n",
        "        print({k: first.get(k) for k in ('title','level','page_start','page_end') if k in first})\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Stage 05 — Tables (05_tables.json) and 06 — Figures (06_figures.json)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "tabs = _read_json(ART['tables']); figs = _read_json(ART['figures'])\n",
        "def _count_list(x):\n",
        "    return len(x) if isinstance(x, list) else (x.get('items') and len(x['items']) if isinstance(x, dict) else 0)\n",
        "print('tables_count =', _count_list(tabs) if tabs is not None else 'missing')\n",
        "print('figures_count =', _count_list(figs) if figs is not None else 'missing')\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Stage 06a — Title/Caption Enricher (consumption check)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "et = _read_json(ART['enriched_tables']); ef = _read_json(ART['enriched_figures'])\n",
        "def _brief_first(lst):\n",
        "    if isinstance(lst, list) and lst:\n",
        "        x = lst[0]\n",
        "        return {k: x.get(k) for k in ('id','title','title_source','normalized_id','continued') if isinstance(x, dict) and k in x}\n",
        "    return None\n",
        "if isinstance(et, list):\n",
        "    print('enriched_tables =', len(et), _brief_first(et))\n",
        "else:\n",
        "    print('enriched_tables missing')\n",
        "if isinstance(ef, list):\n",
        "    print('enriched_figures =', len(ef), _brief_first(ef))\n",
        "else:\n",
        "    print('enriched_figures missing')\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Stage 06b — Layout Sketch (optional)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "ls = _read_json(ART['layout_sketch'])\n",
        "if ls:\n",
        "    keys = [k for k in ('schema_version','grid','elements','columns') if k in ls]\n",
        "    print({k: (len(ls[k]) if isinstance(ls[k], list) else ls[k]) for k in keys})\n",
        "else:\n",
        "    print('layout_sketch missing (ok)')\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Stage 07 — Reflowed Sections (07_reflowed.json)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "rf = _read_json(ART['reflowed'])\n",
        "if not rf:\n",
        "    print('Missing:', ART['reflowed'])\n",
        "else:\n",
        "    print({k: rf.get(k) for k in ('status','section_count','timestamp') if k in rf})\n",
        "    rs = rf.get('reflowed_sections') or []\n",
        "    if rs:\n",
        "        sec0 = rs[0]\n",
        "        print('first_section.title =', sec0.get('title'))\n",
        "        t0 = (sec0.get('tables') or [None])[0]\n",
        "        if isinstance(t0, dict):\n",
        "            print('first_table.title_source =', t0.get('title_source'), 'title =', t0.get('title'))\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Stage 07½ — Requirements Miner (07_requirements.json)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "rq = _read_json(ART['reqs'])\n",
        "if not rq:\n",
        "    print('Missing:', ART['reqs'])\n",
        "else:\n",
        "    reqs = rq.get('requirements', rq if isinstance(rq, list) else [])\n",
        "    print('requirements_count =', len(reqs))\n",
        "    # small distribution by source & modality\n",
        "    from collections import Counter\n",
        "    src = Counter([r.get('from','?') for r in reqs])\n",
        "    mod = Counter([r.get('modality','?') for r in reqs])\n",
        "    print('by_source =', dict(src))\n",
        "    print('modalities =', dict(mod))\n",
        "    for r in reqs[:5]:\n",
        "        print({\n",
        "            'requirement_id': r.get('requirement_id'),\n",
        "            'modality': r.get('modality'),\n",
        "            'section_path': (r.get('source') or {}).get('section_path'),\n",
        "            'text_raw': (r.get('text_raw') or '')[:180]\n",
        "        })\n"
      ]
    },
    {
