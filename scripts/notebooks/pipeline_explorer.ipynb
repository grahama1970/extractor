    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Requires: pip install python-arango\n",
        "# Env: ARANGO_URL, ARANGO_DB, ARANGO_USER, ARANGO_PASSWORD\n",
        "import os, sys\n",
        "try:\n",
        "    from arango import ArangoClient  # type: ignore\n",
        "    HAVE_ARANGO = True\n",
        "except Exception:\n",
        "    HAVE_ARANGO = False\n",
        "    print('python-arango not installed. pip install python-arango to enable DB cells.')\n",
        "\n",
        "if HAVE_ARANGO:\n",
        "    ARANGO_URL = os.environ.get('ARANGO_URL', 'http://127.0.0.1:8529')\n",
        "    ARANGO_DB  = os.environ.get('ARANGO_DB',  'extractor')\n",
        "    ARANGO_USER= os.environ.get('ARANGO_USER', 'root')\n",
        "    ARANGO_PASS= os.environ.get('ARANGO_PASSWORD', '')\n",
        "    client = ArangoClient(hosts=ARANGO_URL)\n",
        "    try:\n",
        "        db = client.db(ARANGO_DB, username=ARANGO_USER, password=ARANGO_PASS)\n",
        "        print('connected:', ARANGO_URL, ARANGO_DB)\n",
        "        print('collections:', sorted([c['name'] for c in db.collections() if not c['system']])[:12])\n",
        "    except Exception as e:\n",
        "        print('Arango connect failed:', e)\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "# Example AQL slices (adjust collection names to your schema)\n",
        "if HAVE_ARANGO:\n",
        "    queries = {\n",
        "      'sections': 'FOR s IN sections LIMIT 5 RETURN KEEP(s, [\\"_key\\", \\"title\\", \\"level\\"])',\n",
        "      'tables':   'FOR t IN tables   LIMIT 5 RETURN KEEP(t, [\\"_key\\", \\"title\\", \\"page\\"])',\n",
        "      'figures':  'FOR f IN figures  LIMIT 5 RETURN KEEP(f, [\\"_key\\", \\"title\\", \\"page\\"])',\n",
        "      'requirements': 'FOR r IN requirements LIMIT 5 RETURN KEEP(r, [\\"_key\\", \\"requirement_id\\", \\"modality\\"])',\n",
        "      'proofs':   'FOR p IN proofs   LIMIT 5 RETURN KEEP(p, [\\"_key\\", \\"requirement_id\\", \\"success\\"])',\n",
        "    }\n",
        "    for name, q in queries.items():\n",
        "        try:\n",
        "            print(name, list(db.aql.execute(q)))\n",
        "        except Exception as e:\n",
        "            print(name, 'query failed:', e)\n"
      ]
    }
