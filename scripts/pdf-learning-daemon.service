[Unit]
Description=Continuous PDF Learning Daemon for Extractor
After=network.target

[Service]
Type=simple
User=graham
WorkingDirectory=%h/workspace/experiments/extractor
Environment=PATH=%h/workspace/experiments/extractor/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/workspace/experiments/extractor/.venv/bin/python scripts/pdf_learning_daemon.py \
    --corpus /mnt/storage12tb/extractor_corpus \
    --interval 300
Restart=always
RestartSec=30

# Logging
StandardOutput=append:/var/log/pdf-learning-daemon.log
StandardError=append:/var/log/pdf-learning-daemon.log

[Install]
WantedBy=multi-user.target
