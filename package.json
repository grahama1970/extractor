{
  "name": "extractor",
  "version": "1.0.0",
  "description": "Advanced multi-format document extraction system with self-correcting AI agents, annotation-guided learning, and continuous improvement through metadata accumulation. Handles PDFs, DOCX, PPTX, XML, HTML, and more with enterprise-grade accuracy.",
  "main": "index.js",
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "tests"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "ux:check": "node scripts/ux_check_broken.mjs",
    "ux:check:cdp": "node scripts/ux_check_cdp.mjs",
    "ux:center": "node scripts/ux_check_center_pane.mjs",
    "ux:center:pointer": "POINTER_ONLY=1 node scripts/ux_check_center_pane.mjs",
    "ux:left-rail": "node scripts/ux_check_left_rail.mjs",
    "ux:snapshots": "node scripts/ux_snapshots.mjs",
    "ux:ingest": "node scripts/ux_ingest.mjs",
    "ux:normalize": "node scripts/ux_normalize.mjs",
    "backend:dev": "python -m extractor.core.scripts.server --host 0.0.0.0 --port 8000"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/grahama1970/extractor.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/grahama1970/extractor/issues"
  },
  "homepage": "https://github.com/grahama1970/extractor#readme",
  "devDependencies": {
    "puppeteer": "^24.20.0"
  }
}
